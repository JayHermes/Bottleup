# Copy this file to `.env` (git-ignored) and fill in the real values.
# Env plugins (Vite) inject these into the browser bundle — never put a secret here.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alternative supported by the app:
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox access token — bare value only (no `import.meta.env.` prefix).
# MUST be a browser/scoped token, not a secret token, and restricted via the
# Mapbox URL-allowlist to your production + preview domains.
VITE_MAPBOX_TOKEN=pk.your-scoped-browser-token